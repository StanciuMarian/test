# Copy to .env and change both values before running a real event.
CTF_KEY=change-me-juice-shop-ctf-key
CTFD_SECRET_KEY=change-me-ctfd-secret
JUICE_SHOP_PROFILE=training
# Used by scripts/setup-ctfd.sh and scripts/start-all.sh (start-all.sh generates one if .env is missing).
CTFD_ADMIN_PASSWORD=change-me-admin-password
